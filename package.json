{
  "name": "auroic-instagram-assistant",
  "version": "1.0.0-beta",
  "type": "module",
  "description": "Personal Instagram AI assistant — monitors DMs, detects triggers, replies via AI with human-like typing.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && tsc-alias && cp src/runtime/runtime.json dist/runtime/runtime.json && mkdir -p dist/dashboard && cp src/dashboard/index.html dist/dashboard/index.html && mkdir -p dist/router && cp src/router/commands.json dist/router/commands.json",
    "start": "node dist/index.js",
    "dev": "tsx --watch src/index.ts",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "postinstall": "npx playwright install chromium-headless-shell"
  },
  "keywords": [
    "instagram",
    "ai",
    "assistant",
    "playwright",
    "automation"
  ],
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@huggingface/transformers": "^3.8.1",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.5",
    "node-emoji": "^2.2.0",
    "ollama": "^0.6.3",
    "playwright": "^1.58.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.37",
    "drizzle-kit": "^0.31.9",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
