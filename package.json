{
  "name": "auroic-instagram-assistant",
  "version": "1.0.0-beta",
  "type": "module",
  "description": "Personal Instagram AI assistant — monitors DMs, detects triggers, replies via AI with human-like typing.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx --watch src/index.ts",
    "check": "tsc --noEmit",
    "postinstall": "npx playwright install chromium-headless-shell"
  },
  "keywords": [
    "instagram",
    "ai",
    "assistant",
    "playwright",
    "automation"
  ],
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "axios": "^1.13.6",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.6.1",
    "hono": "^4.12.3",
    "playwright": "^1.58.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.35",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
