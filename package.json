{
  "name": "auroic",
  "version": "1.0.0",
  "type": "module",
  "description": "Conversational AI agent for chat automation with multi-message intent detection, passive monitoring, human-like auto-replies, command execution, and media automation.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && tsc-alias && mkdir -p dist/dashboard && cp src/dashboard/index.html dist/dashboard/index.html",
    "start": "node dist/index.js",
    "dev": "tsx --watch src/index.ts",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:generate:config": "drizzle-kit generate --config drizzle-config.config.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:config": "drizzle-kit migrate --config drizzle-config.config.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "postinstall": "npx playwright install chromium-headless-shell"
  },
  "keywords": [
    "instagram",
    "ai",
    "assistant",
    "playwright",
    "automation"
  ],
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "better-sqlite3": "^12.9.0",
    "discord.js": "^14.26.4",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.14",
    "music-metadata": "^11.12.3",
    "node-emoji": "^2.2.0",
    "ollama": "^0.6.3",
    "playwright-core": "^1.59.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "drizzle-kit": "^0.31.10",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
