# Chromium Setup
PROFILE_DIR=data/chrome-auroic

#  AI API 
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_API_KEY=your_api_key
AI_API_MODEL=llama-3.1-8b-instant
AI_SYSTEM_PROMPT=You are a helpful and concise AI assistant. Reply naturally and keep responses short and conversational.
AI_API_TIMEOUT=30000

#  Instagram 
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

#  Chat IDs (comma-separated) 
# Get these from Instagram DM URLs: instagram.com/direct/t/CHAT_ID
CHAT_IDS=

# Triggers
# Comma-separated mention triggers (e.g. auroic.ai,bot)
TRIGGER_MENTIONS=auroic.ai,bot
# Comma-separated hashtag triggers (e.g. ai,ask)
TRIGGER_HASHTAGS=ai,ask
# Comma-separated keyword triggers (e.g. help,support)
TRIGGER_KEYWORDS=help,support
# Whether to trigger on replies to the bot's messages (true/false)
TRIGGER_ON_REPLY=true

#  Polling 
POLL_INTERVAL_MS=10000

#  Typing simulation 
TYPING_POST_RESPONSE_DELAY_MS=1500

#  Rate limiting 
MAX_REQUESTS_PER_MIN=30
MAX_TOKENS_PER_MIN=60000

#  Conversation history limits 
MAX_HISTORY_MESSAGES=10
MAX_HISTORY_TOKENS=2000

#  Message batching 
BATCH_WINDOW_MS=2000

#  Per-user cooldown 
USER_COOLDOWN_MS=5000

#  Response token limit 
MAX_OUTPUT_TOKENS=300

#  Retry 
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000

#  Database 
DB_PATH=./data/state.db

#  Logging 
LOG_LEVEL=info
